{
  "file": "IntentCommandMapping.json",
  "system": "STM32ReferenceSystem",
  "policy": "STM32IgniteAuthPolicy",
  "description": "Defines the commands permitted for each intent within each STM32 subsystem.",

  "mappings": [
    {
      "subSystem": "GPIO",
      "intentMappings": [
        {
          "intent": "IntentHash1",
          "commands": [
            "ReadPinState"
          ]
        },
        {
          "intent": "IntentHash2",
          "commands": [
            "SetPinState"
          ]
        }
      ]
    },
    {
      "subSystem": "ADC",
      "intentMappings": [
        {
          "intent": "IntentHash3",
          "commands": [
            "ReadADCChannel"
          ]
        }
      ]
    },
    {
      "subSystem": "Memory",
      "intentMappings": [
        {
          "intent": "IntentHash4",
          "commands": [
            "ReadMemoryRegion"
          ]
        }
      ]
    },
    {
      "subSystem": "FirmwareManager",
      "intentMappings": [
        {
          "intent": "IntentHash5",
          "commands": [
            "GetFirmwareVersion"
          ]
        },
        {
          "intent": "IntentHash6",
          "commands": [
            "RequestFirmwareUpdate"
          ]
        }
      ]
    },
    {
      "subSystem": "SystemMonitor",
      "intentMappings": [
        {
          "intent": "IntentHash7",
          "commands": [
            "ReadSystemHealth"
          ]
        }
      ]
    }
  ]
}
